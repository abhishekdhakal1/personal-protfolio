# Application
NODE_ENV=production

# Server
PORT=5000

# MongoDB - Copy your MongoDB Atlas connection string here
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=

# JWT Authentication - Generate a strong secret key
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin Credentials - Set your portfolio admin account
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=strong-password-here

# Client URL - Point to your deployed frontend (Vercel)
# For Render: update this after frontend deployment URL is known
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary - image uploads persist here instead of local disk (wiped on redeploy)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
